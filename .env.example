# Chave do provedor de LLM (Anthropic). Obrigatória para o agent responder.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado pelo agent (formato provider/model do Mastra).
# Padrão: anthropic/claude-opus-5-5. Alternativa mais barata: anthropic/claude-haiku-5-5
LLM_MODEL=anthropic/claude-opus-5-5

# Segredo do JWT de sessão (HS256). Obrigatório em produção.
SESSION_SECRET=troque-este-segredo

# Validade da sessão em segundos (renovada a cada requisição). Padrão: 8 horas.
SESSION_TTL_SECONDS=28800

# Probabilidade (0 a 1) de o serviço de chamados simulado ficar indisponível numa chamada.
TICKET_OUTAGE_RATE=0.15

# Caminho do arquivo de persistência (JSON). Padrão: ./data/db.json
# DATA_FILE=./data/db.json
